# Kit CAE Extension Backend Configuration
# Update these values to match your kit-cae extension server

# WebSocket API for control and data (kit-cae extension)
REACT_APP_KIT_API_HOST=localhost
REACT_APP_KIT_API_PORT=49080
REACT_APP_KIT_API_PROTO=ws
# REACT_APP_KIT_API_TIMEOUT=30000  # Optional: Request timeout in milliseconds (default: 30000)

# WebRTC Signaling Server for video streaming (Omniverse viewport)
REACT_APP_OV_SIGNAL_HOST=localhost
REACT_APP_OV_SIGNAL_PORT=49100

